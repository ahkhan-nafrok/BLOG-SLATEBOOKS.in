---
import BaseLayout from './BaseLayout.astro';

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: heroImage || 'https://blog.slatebooks.in/images/og-default.jpg',
  datePublished: pubDate,
  dateModified: updatedDate || pubDate,
  author: {
    '@type': 'Organization',
    name: 'Slatebooks',
    url: 'https://slatebooks.in',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Slatebooks',
    url: 'https://slatebooks.in',
  },
});
---

<BaseLayout title={`${title} — Slatebooks Journal`} description={description} ogImage={heroImage}>

  <script type="application/ld+json" set:html={articleSchema} />

  <!-- Cover image -->
  {heroImage && (
    <div class="w-full max-h-[480px] overflow-hidden bg-zinc-900">
      <img src={heroImage} alt={title} class="w-full h-full object-cover" />
    </div>
  )}

  <article class="max-w-2xl mx-auto px-6 py-16">

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="flex gap-3 mb-6">
        {tags.map((tag) => (
          <span class="text-xs tracking-widest uppercase text-zinc-600 border border-zinc-800 px-3 py-1">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Title -->
    <h1 class="text-3xl sm:text-4xl font-light text-white leading-tight mb-4">
      {title}
    </h1>

    <!-- Description -->
    <p class="text-zinc-400 text-lg font-light mb-8 leading-relaxed">
      {description}
    </p>

    <!-- Date -->
    <div class="flex items-center gap-4 pb-10 border-b border-zinc-900 mb-10">
      <time class="text-xs tracking-widest uppercase text-zinc-700">
        {formattedDate}
      </time>
      {updatedDate && (
        <span class="text-xs tracking-widest uppercase text-zinc-800">
          Updated {new Date(updatedDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}
        </span>
      )}
    </div>

    <!-- Body -->
    <div class="prose prose-invert prose-zinc max-w-none
                prose-headings:font-light prose-headings:tracking-tight prose-headings:text-white
                prose-p:text-zinc-400 prose-p:leading-relaxed prose-p:font-light
                prose-a:text-white prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-zinc-300
                prose-strong:text-white prose-strong:font-medium
                prose-blockquote:border-zinc-800 prose-blockquote:text-zinc-500
                prose-code:text-zinc-300 prose-code:bg-zinc-900 prose-code:px-1.5 prose-code:py-0.5
                prose-pre:bg-zinc-950 prose-pre:border prose-pre:border-zinc-800
                prose-img:w-full prose-hr:border-zinc-900">
      <slot />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t border-zinc-900">
      <a href="/" class="text-xs tracking-widest uppercase text-zinc-600 hover:text-white transition-colors">
        ← All Articles
      </a>
    </div>

  </article>

</BaseLayout>