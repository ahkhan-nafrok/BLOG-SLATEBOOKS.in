---
// src/components/HeroSlider.astro
// Props: slides — array of { title, tag, description, href, image }
const { slides = [] } = Astro.props;
if (slides.length === 0) return;
---

<section
  class="hero-slider relative w-full overflow-hidden bg-zinc-950"
  style="height: clamp(420px, 70vh, 680px);"
  aria-label="Featured articles"
>

  <!-- ── Slides ─────────────────────────────────── -->
  {slides.map((slide, i) => (
    <div
      class={`slide absolute inset-0 transition-opacity duration-700 ease-in-out ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
      data-index={i}
      aria-hidden={i !== 0}
    >
      <!-- Background image -->
      {slide.image ? (
        <img
          src={slide.image}
          alt=""
          class="w-full h-full object-cover select-none"
          draggable="false"
        />
      ) : (
        <div class="w-full h-full bg-zinc-950" />
      )}

      <!-- Dark gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-black/10" />

      <!-- Slide content -->
      <div class="absolute bottom-0 left-0 right-0 max-w-6xl mx-auto px-6 pb-20 sm:pb-16">

        <!-- Tag -->
        {slide.tag && (
          <p class="text-xs tracking-widest uppercase text-zinc-400 mb-4">
            {slide.tag}
          </p>
        )}

        <!-- Title -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white leading-tight max-w-2xl mb-6">
          {slide.title}
        </h2>

        <!-- CTA -->
        
          href={slide.href}
          class="inline-block text-xs tracking-widest uppercase px-7 py-3 border border-white text-white hover:bg-white hover:text-black transition-colors duration-300"
        >
          Read Article →
        </a>

      </div>
    </div>
  ))}

  <!-- ── Dot navigation ────────────────────────── -->
  {slides.length > 1 && (
    <div class="dots absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
      {slides.map((_, i) => (
        <button
          class={`dot h-[3px] transition-all duration-400 cursor-pointer border-0 p-0 ${i === 0 ? 'w-6 bg-white' : 'w-[6px] bg-zinc-600 hover:bg-zinc-400'}`}
          data-slide={i}
          aria-label={`Go to slide ${i + 1}`}
        />
      ))}
    </div>
  )}

</section>

<script>
  const slider = document.querySelector('.hero-slider');
  if (!slider) throw new Error();

  const slides = slider.querySelectorAll('.slide');
  const dots   = slider.querySelectorAll('.dot');
  let current  = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(next: number) {
    // Outgoing slide
    slides[current].classList.replace('opacity-100', 'opacity-0');
    slides[current].classList.replace('z-10', 'z-0');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current]?.classList.remove('w-6', 'bg-white');
    dots[current]?.classList.add('w-[6px]', 'bg-zinc-600');

    current = next;

    // Incoming slide
    slides[current].classList.replace('opacity-0', 'opacity-100');
    slides[current].classList.replace('z-0', 'z-10');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current]?.classList.remove('w-[6px]', 'bg-zinc-600');
    dots[current]?.classList.add('w-6', 'bg-white');
  }

  function advance() {
    goTo((current + 1) % slides.length);
  }

  function start() { timer = setInterval(advance, 5000); }
  function stop()  { clearInterval(timer); }

  // Dot clicks
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { stop(); goTo(i); start(); });
  });

  // Pause on hover
  slider.addEventListener('mouseenter', stop);
  slider.addEventListener('mouseleave', start);

  if (slides.length > 1) start();
</script>