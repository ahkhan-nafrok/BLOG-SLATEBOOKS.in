---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-900 mt-24">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-6">

    <!-- Left -->
    <span class="text-xs tracking-widest uppercase text-zinc-600">
      © {year} Slatebooks
    </span>

    <!-- Right links -->
    <div class="flex items-center gap-8">
      <a href="/" class="text-xs tracking-widest uppercase text-zinc-600 hover:text-white transition-colors duration-200">
        Journal
      </a>
      <a href="https://slatebooks.in" class="text-xs tracking-widest uppercase text-zinc-600 hover:text-white transition-colors duration-200">
        Store
      </a>
      <a href="https://slatebooks.in/about" class="text-xs tracking-widest uppercase text-zinc-600 hover:text-white transition-colors duration-200">
        About
      </a>
    </div>

  </div>
</footer>